# PhysicsMind settings. Copy this file to .env on your own computer; online, paste the same names into the
# Streamlit app's Secrets page instead. Never commit a real key.

# AI tutor (optional, free). Groq is tried first, then OpenRouter. Either one alone also works.
# Groq key: https://console.groq.com/keys      OpenRouter key: https://openrouter.ai/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# How many AI-tutor questions one visit may ask, so the free daily allowance lasts. 0 turns the AI off.
AI_QUESTIONS_PER_VISIT=10

# Online feedback (optional). Leave empty to keep feedback in physicsmind.db on this computer.
# Set both to save feedback in your Supabase table instead (see DEPLOY.md).
SUPABASE_URL=
SUPABASE_KEY=
